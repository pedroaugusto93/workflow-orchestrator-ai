APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_ACCESS_TOKEN=change-me-long-random-value
AGENT_TOKEN=change-me-another-random-value
DATABASE_URL=sqlite:///./data/app.db
APPROVAL_REQUIRED=true
ALLOW_FORCE_REPROCESS=false
CONNECTOR_PACKAGE=private_connectors
CHROME_DEBUG_HOST=127.0.0.1
CHROME_DEBUG_PORT=9222
POLL_INTERVAL_SECONDS=5

# Portal A — valores reais ficam somente no agente local.
PORTAL_A_CREATE_URL=
PORTAL_A_SEARCH_URL=
PORTAL_A_COMMITMENT_UNIT_CODE=
PORTAL_A_RECEIPT_DIR=./artifacts/receipts_a
PORTAL_A_DOCUMENT_REQUIRED=true

# Portal B — valores reais/organizacionais ficam somente no agente local.
PORTAL_B_URL=
PORTAL_B_JUSTIFICATION=
PORTAL_B_CATALOG_CODE=
PORTAL_B_CATALOG_TEXT=
PORTAL_B_RECEIPT_DIR=./artifacts/receipts_b
