APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_ACCESS_TOKEN=change-me-long-random-value
AGENT_TOKEN=change-me-another-random-value
DATABASE_URL=sqlite:///./data/app.db
APPROVAL_REQUIRED=true
ALLOW_FORCE_REPROCESS=false
CONNECTOR_PACKAGE=private_connectors
CHROME_DEBUG_HOST=127.0.0.1
CHROME_DEBUG_PORT=9222
POLL_INTERVAL_SECONDS=5

# Portal A — configure apenas no agente local. Não commite valores reais.
PORTAL_A_CREATE_URL=
PORTAL_A_SEARCH_URL=
PORTAL_A_COMMITMENT_UNIT_CODE=
PORTAL_A_RECEIPT_DIR=./artifacts/receipts
PORTAL_A_DOCUMENT_REQUIRED=true

# Portal B será ligado na próxima etapa da refatoração.
PORTAL_B_URL=
